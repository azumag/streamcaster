FROM node:22.23.4-alpine

# 必要パッケージのインストール
RUN apk add --no-cache \
    bash \
    curl \
    docker-cli \
    ffmpeg

# 作業ディレクトリ設定
WORKDIR /app

# standalone controller lockfileから本番依存だけをインストール
COPY controller/package.json controller/package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts

# アプリケーションファイルをコピー
COPY controller/ ./
COPY scripts/ ./scripts/

# 実行権限付与
RUN chmod +x scripts/*.sh

# ポート公開
EXPOSE 8080

# 起動コマンド
CMD ["node", "controller.js"]
