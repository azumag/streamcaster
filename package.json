{
  "name": "streamcaster",
  "version": "1.0.0",
  "description": "UDP to RTMP streaming system",
  "private": true,
  "workspaces": [
    "controller",
    "operator-bridge"
  ],
  "scripts": {
    "prepare": "husky install || true",
    "controller:start": "cd controller && npm start",
    "controller:test": "cd controller && npm test",
    "controller:lint": "cd controller && npm run lint",
    "controller:ci": "cd controller && npm run ci",
    "blmf:windows:test": "node tools/blmf-windows-poc/test.cjs",
    "blmf:windows:start": "node tools/blmf-windows-poc/run.cjs"
  },
  "devDependencies": {
    "husky": "^8.0.3"
  },
  "overrides": {
    "dockerode@^4.0.2": {
      "uuid": "11.1.1"
    },
    "googleapis-common@7": {
      "uuid": "11.1.1"
    },
    "gaxios@6": {
      "uuid": "11.1.1"
    },
    "@istanbuljs/load-nyc-config@1": {
      "js-yaml": "4.3.2"
    }
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || ^26.12.1"
  },
  "author": "",
  "license": "MIT"
}
