# StreamCaster Configuration
# Google Drive API設定

# Google Drive API Key (公開フォルダ用)
GOOGLE_DRIVE_API_KEY=your_google_drive_api_key_here

# OAuth認証 (プライベートフォルダ用)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REFRESH_TOKEN=your_refresh_token_here

# アプリケーション設定
PORT=8080
NODE_ENV=development

# 配信設定
RTMP_SERVER=rtmp://localhost:1935/live
STREAM_KEY=stream

# ログレベル
LOG_LEVEL=info

# セキュリティ設定
ALLOWED_ORIGINS=http://localhost:8080

# リソース制限
MAX_DOWNLOAD_SIZE=1073741824  # 1GB
TEMP_FILE_TTL=3600000        # 1時間（ミリ秒）

# 動画エンコード設定（画質安定化）
VIDEO_BITRATE=2000k          # 動画ビットレート（高品質: 3000k, 標準: 2000k, 低負荷: 1000k）
AUDIO_BITRATE=128k           # 音声ビットレート
VIDEO_GOP_SIZE=120           # GOPサイズ（キーフレーム間隔、4秒間隔推奨）
VIDEO_PRESET=medium          # エンコード速度（ultrafast, superfast, veryfast, faster, fast, medium, slow, slower, veryslow）
# BLMF 2026 control plane (disabled by default)
BLMF_ENABLED=false
# JSON array: [{"id":"operator-name","token":"long-random-secret","canPanic":true}]
BLMF_OPERATORS_JSON=
BLMF_MAIN_OBS_URL=ws://127.0.0.1:4455
BLMF_MAIN_OBS_PASSWORD=
# Prefer the Sub PC's Tailscale IP or event-LAN IP; never expose OBS websocket to WAN.
BLMF_SUB_OBS_URL=ws://100.64.0.20:4455
BLMF_SUB_OBS_PASSWORD=
BLMF_DIRECTOR_LEASE_TTL_MS=15000
BLMF_COMMAND_MAX_AGE_MS=10000
BLMF_MAIN_TAKE_DELAY_MS=0
BLMF_ENTRY_MEDIA_INPUT=entry_player
BLMF_MAIN_VENUE_SCENE=VRC_VENUE
BLMF_MAIN_ENTRY_SCENE=ENTRY_FULLSCREEN
BLMF_SUB_ENTRY_SCENE=ENTRY
BLMF_SUB_STANDBY_SCENE=STANDBY
